/** Header-tolerant access to the three approved tabs: Clients, Membership, Attendance. */
function normalizeHeader_(value) { return String(value || '').trim().toLowerCase().replace(/[^a-z0-9]/g, ''); }
function readSheetObjects_(sheetName) { var ss = getSpreadsheet_(); var sheet = ss.getSheetByName(sheetName); if (!sheet) throw new Error('Required sheet tab is missing: ' + sheetName); var values = sheet.getDataRange().getValues(); if (!values.length) return { sheet: sheet, headers: [], rows: [] }; var headers = values[0].map(function(h){return String(h || '').trim();}); var rows = values.slice(1).filter(function(row){return row.some(function(v){return v !== '' && v !== null;});}).map(function(row, i){ var obj = { _row: i + 2 }; headers.forEach(function(h, j){ obj[h] = row[j]; obj[normalizeHeader_(h)] = row[j]; }); return obj; }); return { sheet: sheet, headers: headers, rows: rows }; }
function getField_(obj, aliases) { for (var i = 0; i < aliases.length; i++) { var key = normalizeHeader_(aliases[i]); if (obj && obj[key] !== undefined && obj[key] !== '') return obj[key]; } return ''; }
function asText_(v) { return v instanceof Date ? Utilities.formatDate(v, Session.getScriptTimeZone() || 'Asia/Kolkata', 'yyyy-MM-dd') : String(v === null || v === undefined ? '' : v).trim(); }
function asDate_(v) { if (v instanceof Date && !isNaN(v.getTime())) return new Date(v.getFullYear(), v.getMonth(), v.getDate()); if (!v) return null; var d = new Date(v); if (isNaN(d.getTime())) return null; return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
function dayDiff_(fromDate, toDate) { var a = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate()).getTime(); var b = new Date(toDate.getFullYear(), toDate.getMonth(), toDate.getDate()).getTime(); return Math.round((b-a)/86400000); }
function findClientAndMembership_(query, warningDaysOverride) { var clients = readSheetObjects_(APP_CONFIG.SHEET_CLIENTS).rows; var memberships = readSheetObjects_(APP_CONFIG.SHEET_MEMBERSHIP).rows; var q = String(query || '').trim().toLowerCase(); var matches = clients.filter(function(c){ if (!q) return true; return Object.keys(c).some(function(key){ if (key === '_row') return false; var value = c[key]; return value !== null && value !== undefined && asText_(value).toLowerCase().indexOf(q) >= 0; }); }); return matches.map(function(c){ var id=asText_(getField_(c,['Membership ID','MembershipID','Member ID','ID'])); var m=memberships.find(function(x){return asText_(getField_(x,['Membership ID','MembershipID','Member ID','ID']))===id;}) || {}; return buildMember_(c,m,warningDaysOverride); }); }
function buildMember_(client, membership, warningDaysOverride) { var id=asText_(getField_(client,['Membership ID','MembershipID','Member ID','ID'])); var name=asText_(getField_(client,['Name','Client Name','Full Name'])); var mobile=asText_(getField_(client,['Mobile','Phone','Mobile Number','Contact'])); var pkg=asText_(getField_(membership,['Package','Membership','Plan','Package Name'])); var start=asDate_(getField_(membership,['Start Date','Membership Start','Start'])); var end=asDate_(getField_(membership,['End Date','Expiry Date','Membership End','End'])); var today=asDate_(new Date()); var days=end?dayDiff_(today,end):null; var warningDays=getExpiryWarningDays_(warningDaysOverride); var status=!end?'EXPIRED':days<0?'EXPIRED':days<=warningDays?'EXPIRING SOON':'ACTIVE'; var attendance=getOpenAttendanceForMember_(id); return { membershipId:id, name:name, mobile:mobile, package:pkg, startDate:start?asText_(start):'', endDate:end?asText_(end):'', remainingDays:days, membershipStatus:status, attendanceStatus:attendance?'INSIDE':'OUTSIDE', warnings:!end?['Membership end date is missing or invalid.']:days!==null&&days<0?['Membership is expired.']:days!==null&&days<=warningDays?['Membership is expiring soon.']:[] , clientDetails:client }; }
