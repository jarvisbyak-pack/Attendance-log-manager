function logAuditEvent_(event, details) { try { var props=PropertiesService.getScriptProperties();var raw=props.getProperty('AUDIT_EVENTS')||'[]';var list=JSON.parse(raw);list.push({event:event,details:details||{},time:new Date().toISOString()});props.setProperty('AUDIT_EVENTS',JSON.stringify(list.slice(-200))); } catch(e) { console.error('Audit logging failed',e); } }
function logSecurityEvent_(event, details) { logAuditEvent_('SECURITY_'+event,details);sendTelegramNotification_('security',{event:event,details:details||{}}); }
function getNotificationSettings_() { return {telegramEnabled:getScriptProperty_(APP_CONFIG.PROP_TELEGRAM_ENABLED,'false')==='true',notifyEntry:getScriptProperty_(APP_CONFIG.PROP_NOTIFY_ENTRY,'true')==='true',notifyExit:getScriptProperty_(APP_CONFIG.PROP_NOTIFY_EXIT,'true')==='true',notifyExpiry:getScriptProperty_(APP_CONFIG.PROP_NOTIFY_EXPIRY,'true')==='true',notifySecurity:getScriptProperty_(APP_CONFIG.PROP_NOTIFY_SECURITY,'true')==='true'}; }
function sendTelegramNotification_(kind, details) { try { var s=getNotificationSettings_();if(getScriptProperty_(APP_CONFIG.PROP_TELEGRAM_ENABLED,'false')!=='true')return;if(kind==='entry'&&!s.notifyEntry||kind==='exit'&&!s.notifyExit||kind==='expiry'&&!s.notifyExpiry||kind==='security'&&!s.notifySecurity)return;var token=getScriptProperty_(APP_CONFIG.PROP_TELEGRAM_BOT_TOKEN,'');var chat=getScriptProperty_(APP_CONFIG.PROP_TELEGRAM_CHAT_ID,'');if(!token||!chat)return;var text='Attendance Log Manager: '+String(kind).toUpperCase()+'\n'+JSON.stringify(details||{});UrlFetchApp.fetch('https://api.telegram.org/bot'+token+'/sendMessage',{method:'post',contentType:'application/json',payload:JSON.stringify({chat_id:chat,text:text}),muteHttpExceptions:true});}catch(e){console.error('Telegram notification failed',e);logAuditEvent_('TELEGRAM_ERROR',{message:String(e)});} }
