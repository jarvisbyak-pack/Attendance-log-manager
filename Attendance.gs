/** Attendance writes are serialized with ScriptLock to reduce duplicate entry/exit races. */
function getOpenAttendanceForMember_(membershipId) { var rows=readSheetObjects_(APP_CONFIG.SHEET_ATTENDANCE).rows; var today=asText_(new Date()); for(var i=rows.length-1;i>=0;i--){var r=rows[i];var id=asText_(getField_(r,['Membership ID','MembershipID','Member ID','ID']));var date=asText_(getField_(r,['Date','Attendance Date']));var entry=getField_(r,['Entry Time','Time In','Check In','Check-in Time']);var exit=getField_(r,['Exit Time','Time Out','Check Out','Check-out Time']);if(id===String(membershipId)&&date===today&&entry&&!exit)return r;}return null; }
function recordAttendanceEntry_(request) { return withScriptLock_(function(){var id=String(request.membershipId||request.memberId||'').trim();if(!id)throw new Error('Membership ID is required.');var member=findClientAndMembership_(id).find(function(m){return m.membershipId===id;});if(!member) {logSecurityEvent_('UNKNOWN_MEMBER_ENTRY',{membershipId:id});throw new Error('Unknown membership ID. Entry was not recorded.');}if(getOpenAttendanceForMember_(id)){logSecurityEvent_('DUPLICATE_ENTRY',{membershipId:id});throw new Error('This member already has an open entry today.');}var sheet=readSheetObjects_(APP_CONFIG.SHEET_ATTENDANCE).sheet;var now=new Date();var date=Utilities.formatDate(now,Session.getScriptTimeZone()||'Asia/Kolkata','yyyy-MM-dd');var headers=sheet.getRange(1,1,1,Math.max(1,sheet.getLastColumn())).getValues()[0];var values=headers.map(function(h){var k=normalizeHeader_(h);var map={date:date,attendanceDate:date,membershipid:id,memberid:id,id:id,name:member.name,clientname:member.name,mobile:member.mobile,phone:member.mobile,entrytime:now,timein:now,checkin:now,exittime:'',timeout:'',durationminutes:'',duration:'',membershipstatus:member.membershipStatus,startdate:member.startDate,enddate:member.endDate,package:member.package,warning:(member.warnings||[]).join(' '),event:'ENTRY',status:'INSIDE'};return map[k]!==undefined?map[k]:'';});sheet.appendRow(values);logAuditEvent_('ENTRY_RECORDED',{membershipId:id,name:member.name,membershipStatus:member.membershipStatus});if(member.membershipStatus==='EXPIRED')logSecurityEvent_('EXPIRED_MEMBER_ENTRY_ATTEMPT',{membershipId:id,name:member.name});sendTelegramNotification_('entry',{membershipId:id,name:member.name,status:member.membershipStatus});return {message:'Entry recorded for '+member.name+'.',member:member,warning:member.membershipStatus==='EXPIRED'?'Membership is expired. Entry was recorded under the approved allow-with-warning policy.':''};}); }
function recordAttendanceExit_(request) { return withScriptLock_(function(){var id=String(request.membershipId||request.memberId||'').trim();if(!id)throw new Error('Membership ID is required.');var found=readSheetObjects_(APP_CONFIG.SHEET_ATTENDANCE);var today=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Asia/Kolkata','yyyy-MM-dd');var target=null;for(var i=found.rows.length-1;i>=0;i--){var r=found.rows[i];if(asText_(getField_(r,['Membership ID','MembershipID','Member ID','ID']))===id&&asText_(getField_(r,['Date','Attendance Date']))===today&&getField_(r,['Entry Time','Time In','Check In'])&&!getField_(r,['Exit Time','Time Out','Check Out'])){target=r;break;}}if(!target){logSecurityEvent_('EXIT_WITHOUT_ENTRY',{membershipId:id});throw new Error('Exit blocked: no active entry for this member today. The event has been flagged.');}var now=new Date();var entryValue=getField_(target,['Entry Time','Time In','Check In']);var entryDate=entryValue instanceof Date?entryValue:new Date(entryValue);var minutes=isNaN(entryDate.getTime())?'':Math.max(0,Math.round((now-entryDate)/60000));var headers=found.sheet.getRange(1,1,1,found.sheet.getLastColumn()).getValues()[0];headers.forEach(function(h,j){var k=normalizeHeader_(h);if(['exittime','timeout','checkout','checkouttime'].indexOf(k)>=0)found.sheet.getRange(target._row,j+1).setValue(now);if(['durationminutes','duration'].indexOf(k)>=0)found.sheet.getRange(target._row,j+1).setValue(minutes);if(k==='status')found.sheet.getRange(target._row,j+1).setValue('EXITED');});logAuditEvent_('EXIT_RECORDED',{membershipId:id,durationMinutes:minutes});sendTelegramNotification_('exit',{membershipId:id,durationMinutes:minutes});return {message:'Exit recorded. Duration: '+minutes+' minutes.',durationMinutes:minutes};}); }
function getLiveAttendance_() { var rows=readSheetObjects_(APP_CONFIG.SHEET_ATTENDANCE).rows;var today=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Asia/Kolkata','yyyy-MM-dd');var live=[];rows.forEach(function(r){var date=asText_(getField_(r,['Date','Attendance Date']));var id=asText_(getField_(r,['Membership ID','MembershipID','Member ID','ID']));var entry=getField_(r,['Entry Time','Time In','Check In']);var exit=getField_(r,['Exit Time','Time Out','Check Out']);if(date===today&&entry&&!exit){var start=entry instanceof Date?entry:new Date(entry);live.push({name:asText_(getField_(r,['Name','Client Name'])),membershipId:id,entryTime:start.toISOString(),duration:!isNaN(start.getTime())?Math.max(0,Math.round((new Date()-start)/60000))+' min':'—',package:asText_(getField_(r,['Package','Membership','Plan'])),endDate:asText_(getField_(r,['End Date','Expiry Date'])),membershipStatus:asText_(getField_(r,['Membership Status']))});}});return {live:live,members:live}; }
function getAttendanceHistory_(request) { var rows=readSheetObjects_(APP_CONFIG.SHEET_ATTENDANCE).rows;var query=String(request.query||'').toLowerCase();var date=String(request.date||'');var records=rows.filter(function(r){var d=asText_(getField_(r,['Date','Attendance Date']));var id=asText_(getField_(r,['Membership ID','MembershipID','Member ID','ID']));var name=asText_(getField_(r,['Name','Client Name']));return (!date||d===date)&&(!query||id.toLowerCase().indexOf(query)>=0||name.toLowerCase().indexOf(query)>=0);}).reverse().slice(0,500).map(function(r){return {date:asText_(getField_(r,['Date','Attendance Date'])),membershipId:asText_(getField_(r,['Membership ID','MembershipID','Member ID','ID'])),name:asText_(getField_(r,['Name','Client Name'])),entryTime:asIsoDateTime_(getField_(r,['Entry Time','Time In','Check In'])),exitTime:asIsoDateTime_(getField_(r,['Exit Time','Time Out','Check Out'])),duration:asText_(getField_(r,['Duration Minutes','Duration'])),membershipStatus:asText_(getField_(r,['Membership Status'])),warning:asText_(getField_(r,['Warning']))};});return {records:records,history:records}; }
function getAttendanceSnapshot_() { var live=getLiveAttendance_().live;var rows=readSheetObjects_(APP_CONFIG.SHEET_ATTENDANCE).rows;var recent=rows.slice(-15).reverse().map(function(r){return {timestamp:asIsoDateTime_(getField_(r,['Exit Time','Entry Time','Date'])),name:asText_(getField_(r,['Name','Client Name'])),membershipId:asText_(getField_(r,['Membership ID','MembershipID','Member ID','ID'])),event:asText_(getField_(r,['Event']))|| (getField_(r,['Exit Time','Time Out'])?'EXIT':'ENTRY'),status:asText_(getField_(r,['Status']))||'Recorded'};});return {live:live,recent:recent}; }
