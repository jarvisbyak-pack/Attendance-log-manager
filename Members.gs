function searchMembers_(request) { var results=findClientAndMembership_(request.query || '', request.expiryWarningDays); var limit=Math.max(1,Math.min(100,Number(request.limit)||30)); if (!results.length) return { member:null, members:[] }; return { member:results[0], members:results.slice(0,limit), count:results.length }; }
function getExpiryLists_(request) { var warningDays=getExpiryWarningDays_(request.expiryWarningDays); var clients=readSheetObjects_(APP_CONFIG.SHEET_CLIENTS).rows; var memberships=readSheetObjects_(APP_CONFIG.SHEET_MEMBERSHIP).rows; var members=clients.map(function(c){var id=asText_(getField_(c,['Membership ID','MembershipID','Member ID','ID']));var m=memberships.find(function(x){return asText_(getField_(x,['Membership ID','MembershipID','Member ID','ID']))===id;})||{};return buildMember_(c,m,warningDays);}); return { expiring:members.filter(function(m){return m.membershipStatus==='EXPIRING SOON';}), expired:members.filter(function(m){return m.membershipStatus==='EXPIRED';}), warningDays:warningDays }; }
